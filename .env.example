# Runtime secret configured in Sites. Verified owner email is used only to bind
# the first owner identity; subsequent authorization uses the pinned Site user ID.
OWNER_EMAIL=
# Optional email subscriptions. Configure as server secrets in Sites.
RESEND_API_KEY=
NEWSLETTER_FROM=

# Canonical HTTPS origin (fallback keeps the existing Sites address).
SITE_URL=

# Required server secret: random >=32 characters, never expose in client code.
RATE_LIMIT_SALT=

# Optional owner-only AI formatting. Server secrets only; choose a compatible model.
OPENAI_API_KEY=
AI_MODEL=
# Optional; defaults to openai. Other providers are currently unsupported.
AI_PROVIDER=
